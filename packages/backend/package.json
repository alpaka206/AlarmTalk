{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env dev --env-file .dev.vars.dev",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "reset:test-data": "node --experimental-strip-types scripts/reset-test-data.ts",
    "reset:test-data:dev": "node --experimental-strip-types scripts/reset-test-data.ts --env-file .dev.vars.dev",
    "migrate:dev": "node --experimental-strip-types scripts/run-remote-migrations.ts --env dev",
    "migrate:prod": "node --experimental-strip-types scripts/run-remote-migrations.ts --env production",
    "secrets:sync:dev": "node --experimental-strip-types scripts/sync-worker-secrets.ts --env dev --env-file .dev.vars.dev",
    "secrets:sync:prod": "node --experimental-strip-types scripts/sync-worker-secrets.ts --env production --env-file .dev.vars.prod",
    "preview:stock": "esbuild scripts/prerender-stock-preview.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/prerender-stock-preview.mjs && node node_modules/.cache/prerender-stock-preview.mjs",
    "publish:stock": "esbuild scripts/publish-stock-clips.ts --bundle --platform=node --format=esm --external:@libsql/client --log-level=error --outfile=node_modules/.cache/publish-stock-clips.mjs && node node_modules/.cache/publish-stock-clips.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/bcryptjs": "^3.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@alarmtalk/shared": "*",
    "@alarmtalk/voice": "*",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "date-holidays": "^3.35.0",
    "hono": "^4.13.5",
    "toucan-js": "^4.1.1"
  }
}
