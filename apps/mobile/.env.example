# Expo build-time env. Anything prefixed with EXPO_PUBLIC_* is inlined
# into the JS bundle, so don't put real secrets here — those belong in
# the backend (Workers secret store) and we hit them via API URL only.
#
# Copy this file to `.env` and fill in your dev values.

EXPO_PROJECT_ROOT=
EXPO_PUBLIC_API_URL=https://voice-alarm-api.voicealarm.workers.dev
EXPO_ROUTER_APP_ROOT=./app
EXPO_ROUTER_IMPORT_MODE=sync

# ===== Google OAuth =====
# https://console.cloud.google.com/apis/credentials
# Web client = id-token receiver / audience used by the backend verifier.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Android client (com.devrel.voicealarm + debug.keystore SHA-1).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# iOS client (only when you build for iOS).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Mirror of the Web client ID — auth.ts reads this for backend audience
# checks during dev. In prod it's wrangler secret GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ===== RevenueCat (later) =====
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
