{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}",
      "**/test/**/*.test.{ts,tsx}"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.96.2",
    "expo": "~55.0.17",
    "expo-apple-authentication": "~55.0.13",
    "expo-auth-session": "~55.0.15",
    "expo-av": "^16.0.8",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.28",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.14",
    "i18next": "^24.2.2",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.4.1",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4",
    "react-refresh": "^0.18.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "^55.0.18",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.16",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.86.0"
  },
  "private": true
}
