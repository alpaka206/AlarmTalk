<?xml version="1.0" encoding="utf-8"?>
<!--
  미리듣기 정지 아이콘. ic_voice_listen_24 와 같은 24dp 그리드·1.8dp 선 굵기로 그려,
  재생 ↔ 정지가 바뀔 때 두께나 크기가 튀지 않는다.

  네모 하나만 두면 빈 체크박스로 읽히므로, 바깥 사각형은 선으로 두고 안쪽을 채운
  '정지 버튼' 형태로 만들었다. 안쪽 사각형의 둥근 모서리(1.2)는 앱의 가장 작은 반경
  토큰(WakerTileShape 12dp = 24dp 그리드에서 약 1.2)과 같은 비율이다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 바깥 테두리 — 듣기 아이콘의 스피커 본체와 같은 시각 크기(세로 약 13)를 유지한다. -->
    <path
        android:pathData="M6.2,7.6m0,2a2,2 0,0 1,2 -2h7.6a2,2 0,0 1,2 2v6.8a2,2 0,0 1,-2 2h-7.6a2,2 0,0 1,-2 -2z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />
    <!-- 안쪽 채움 — '지금 소리가 나고 있고, 누르면 멈춘다'를 한눈에 읽히게 한다.
         바깥 테두리 폭의 절반쯤을 채워야 '정지'로 읽힌다. 더 작으면 녹화 점처럼 보인다. -->
    <path
        android:pathData="M9.5,10.6m0,1.2a1.2,1.2 0,0 1,1.2 -1.2h2.6a1.2,1.2 0,0 1,1.2 1.2v2.6a1.2,1.2 0,0 1,-1.2 1.2h-2.6a1.2,1.2 0,0 1,-1.2 -1.2z"
        android:fillColor="#FFFFFF" />
</vector>
