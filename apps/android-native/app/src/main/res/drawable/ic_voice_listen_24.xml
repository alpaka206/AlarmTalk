<?xml version="1.0" encoding="utf-8"?>
<!--
  목소리 미리듣기(듣기) 아이콘.

  하단 탭 아이콘(Material Symbols Outlined: Alarm·Mic·Menu)과 같은 24dp 그리드에,
  같은 굵기로 보이도록 1.8dp 선으로 그렸다. 채움 없이 선만 쓰는 이유는 이 앱이
  아이콘을 장식이 아니라 표시로만 쓰기 때문 — 색은 Icon(tint) 이 입힌다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 스피커 본체: 좌측 포트 + 원뿔. 모서리를 둥글게 이어 탭 아이콘의 부드러운 인상과 맞춘다. -->
    <path
        android:pathData="M4,9.6h3.1L11.6,5.6v12.8L7.1,14.4H4Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 소리 파동 2줄 — 안쪽이 짧고 바깥쪽이 길어 퍼져 나가는 느낌을 준다. -->
    <path
        android:pathData="M14.9,9.7a3.4,3.4 0,0 1,0 4.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M17.6,7.2a7,7 0,0 1,0 9.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
</vector>
