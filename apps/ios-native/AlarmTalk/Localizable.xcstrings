      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account is scheduled for deletion, so you have been signed out on this device too. Sign in again to cancel the deletion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退会申請中のアカウントのため、この端末でもログアウトしました。もう一度ログインすると退会が取り消されます。"
          }
        }
      }
    },
