            "state": "translated",
            "value": "音声生体情報の処理同意"
          }
        }
      }
    },
    "음성 소스": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice source"
