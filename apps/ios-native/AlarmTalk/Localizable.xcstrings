{
  "sourceLanguage": "ko",
  "strings": {
    "\"%@, 일어날 시간이에요\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@, time to wake up\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@、起きる時間ですよ」"
          }
        }
      }
    },
    "%@ 섹션": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ section"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@セクション"
          }
        }
      }
    },
    "%@ 이용권 · 현재 %lld/%lld명": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plan · %lld/%lld now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@プラン · 現在%lld/%lld人"
          }
        }
      }
    },
    "%@ 이용권 사용 중이에요. 등록은 이용권이 종료된 다음 가능해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ plan is active. You can register a new code once it ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@プランを利用中です。登録はプランの終了後に可能です。"
          }
        }
      }
    },
    "%@ 후에 울려요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@後に鳴ります。"
          }
        }
      }
    },
    "%lld/%lld명 사용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld in use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld人が使用中"
          }
        }
      }
    },
    "%lld/%lld명 사용 · 정원이 가득 차서 공유할 수 없어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld in use · Full, so you can't share"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld人が使用中 · 定員がいっぱいで共有できません"
          }
        }
      }
    },
    "%lld분": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分"
          }
        }
      }
    },
    "%lld시간": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld時間"
          }
        }
      }
    },
    "%lld시간 %lld분": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hours %lld minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld時間%lld分"
          }
        }
      }
    },
    "%lld일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日"
          }
        }
      }
    },
    "%lld일 %lld시간": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days %lld hours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日%lld時間"
          }
        }
      }
    },
    "%lld회": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld times"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld回"
          }
        }
      }
    },
    "'%@' 가 내게 어떻게 말할지 알려주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us how '%@' should talk to you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」があなたにどう話しかけるか教えてください。"
          }
        }
      }
    },
    "'%@' 목소리를 삭제할까요?\n이 목소리를 쓰는 알람은 기본 알람음으로 바뀌어요. 저장된 음원 파일도 함께 삭제돼요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the voice '%@'?\nAlarms using this voice will switch to the default alarm sound, and the saved audio files will be deleted too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の声を削除しますか？\nこの声を使うアラームは既定のアラーム音に変わります。保存された音源ファイルも一緒に削除されます。"
          }
        }
      }
    },
    "'알람 + 음성'을 고르면 등록한 목소리가 함께 울려요. 랜덤 문구를 켜면 아침마다 새로운 메시지로 깨워줘요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 'Alarm + Voice' and the voice you registered will play along. Turn on random messages to be woken with a fresh message each morning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'アラーム + 音声'を選ぶと、登録した声も一緒に鳴ります。ランダムメッセージをオンにすると、毎朝新しいメッセージで起こしてくれます。"
          }
        }
      }
    },
    "+ 시간 추가": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+ Add time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 時間を追加"
          }
        }
      }
    },
    "0% 에서는 앱이 켜져 있을 때 재생되는 음성 폴백이 꺼집니다. OS 알람 톤은 기기의 시스템 알람 음량으로 계속 울립니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 0%, the voice fallback played while the app is open is turned off. The OS alarm tone keeps ringing at the device's system alarm volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0%では、アプリが起動中に再生される音声フォールバックがオフになります。OSのアラーム音は端末のシステムアラーム音量で鳴り続けます。"
          }
        }
      }
    },
    "0원": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "₩0"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0ウォン"
          }
        }
      }
    },
    "12초 이상 2분 이하 구간만 사용할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only use a range between 12 seconds and 2 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上2分以下の区間のみ使用できます。"
          }
        }
      }
    },
    "12초 이상 2분 이하 구간만 학습에 사용할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a 12-second to 2-minute range can be used for training."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上2分以下の区間のみ学習に使用できます。"
          }
        }
      }
    },
    "12초 이상 2분 이하 구간을 골라 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a range between 12 seconds and 2 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上2分以下の区間を選んでください。"
          }
        }
      }
    },
    "12초 이상 2분 이하로 녹음해 주세요. 1분 30초를 권장해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record for 12 seconds to 2 minutes. We recommend 1 minute 30 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上2分以下で録音してください。1分30秒をおすすめします。"
          }
        }
      }
    },
    "12초 이상 2분 이하로 평소 목소리처럼 또박또박 읽어 주세요. 가지고 있는 음성 파일이나 영상으로도 만들 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read clearly in your normal voice for 12 seconds to 2 minutes. You can also use an audio file or video you already have."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上2分以下で、普段の声ではっきりと読んでください。お持ちの音声ファイルや動画でも作成できます。"
          }
        }
      }
    },
    "12초 이상 녹음해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please record for at least 12 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上録音してください。"
          }
        }
      }
    },
    "12초 이상 들리는 구간을 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose a range with at least 12 seconds of clear audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上はっきり聞こえる区間を選んでください。"
          }
        }
      }
    },
    "12초 이상 들리는 구간이 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need a range with at least 12 seconds of clear audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上はっきり聞こえる区間が必要です。"
          }
        }
      }
    },
    "12초 이상 준비해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please prepare at least 12 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上ご用意ください。"
          }
        }
      }
    },
    "12초 이상 준비해야 등록할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need at least 12 seconds to register."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上ないと登録できません。"
          }
        }
      }
    },
    "12초 이상 파일을 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose a file of at least 12 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12秒以上のファイルを選んでください。"
          }
        }
      }
    },
    "1분부터 30분까지 정할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can set anywhere from 1 to 30 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1分から30分まで設定できます。"
          }
        }
      }
    },
    "1초 이상 들리는 음성이 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voice of at least 1 second is required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1秒以上の音声が必要です。"
          }
        }
      }
    },
    "1초 이상 들리는 파일을 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select a file at least 1 second long."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1秒以上の音声が入ったファイルを選択してください。"
          }
        }
      }
    },
    "2명이 함께 사용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 2 people together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人で一緒に利用"
          }
        }
      }
    },
    "2분 이내 구간만 사용할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a range within 2 minutes can be used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2分以内の区間のみ使用できます。"
          }
        }
      }
    },
    "2분 이하 구간만 사용할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only ranges of 2 minutes or less can be used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2分以下の区間のみ使用できます。"
          }
        }
      }
    },
    "2분 이하 음성으로 등록할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can register voice that is 2 minutes or less."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2分以下の音声で登録できます。"
          }
        }
      }
    },
    "30일 뒤에 계정과 모든 데이터가 영구 삭제돼요. 그 전에 다시 로그인하면 탈퇴를 취소할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and all data will be permanently deleted in 30 days. Log in again before then to cancel the deletion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日後にアカウントとすべてのデータが完全に削除されます。それまでに再度ログインすると退会を取り消せます。"
          }
        }
      }
    },
    "30초가 넘는 음성은 잠금 화면에서 울리도록 앞 30초만 사용돼요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voices over 30 seconds use only the first 30 seconds so they can ring on the lock screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30秒を超える音声は、ロック画面で鳴らせるよう最初の30秒だけ使われます。"
          }
        }
      }
    },
    "3회": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 times"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3回"
          }
        }
      }
    },
    "5회": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 times"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5回"
          }
        }
      }
    },
    "60초 이상 녹음한 뒤 학습을 등록해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record at least 60 seconds, then start training."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60秒以上録音してから学習を登録してください。"
          }
        }
      }
    },
    "8자 이상": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8+ characters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8文字以上"
          }
        }
      }
    },
    "8자 이상, 영문·숫자 포함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8+ characters, with letters and numbers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8文字以上、英字と数字を含む"
          }
        }
      }
    },
    "AI 가 화자별 구간을 자동으로 분리해요. 잠깐 시간이 걸려요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI separates each speaker's segments automatically. This takes a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIが話者ごとの区間を自動で分離します。少し時間がかかります。"
          }
        }
      }
    },
    "App Store 결제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store payment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store決済"
          }
        }
      }
    },
    "Apple ID 로그인이 더 이상 유효하지 않아요. 다시 로그인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple ID sign-in is no longer valid. Please sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
