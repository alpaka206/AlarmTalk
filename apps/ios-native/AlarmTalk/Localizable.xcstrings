          "stringUnit": {
            "state": "translated",
            "value": "ようこそ！アカウントが作成されました。"
          }
        }
      }
    },
    "활기차게 몸을 움직이도록 응원해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheers you on to get moving."
          }
