          "stringUnit": {
            "state": "translated",
            "value": "現在のプランから退出して、新しいコードを登録しますか？"
          }
        }
      }
    },
    "현재 이용권이 종료 예정이에요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current pass is scheduled to end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の利用券は終了予定です。"
          }
        }
      }
    },
    "현재 적용된 이용권이 없어 새 이용권으로 적용할게요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have an active plan, so we'll apply this as a new one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在適用中のプランがないため、新しいプランとして適用します。"
          }
        }
      }
    },
    "현재 함께 쓰는 이용권이 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're not sharing a plan right now."
