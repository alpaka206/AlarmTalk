    },
    "음성 오디오를 지웠어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice audio was cleared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声オーディオを削除しました。"
          }
        }
      }
    },
    "음성 탭에서 깨워줄 말을 생성하면 여기에서 다시 확인할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a wake-up message in the Voice tab and you can find it here again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声タブで起こす言葉を作成すると、ここで再び確認できます。"
          }
        }
      }
    },
    "음성 탭에서 만들기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create in the Voice tab"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声タブで作成"
          }
        }
      }
    },
    "음성과 이름을 모두 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please provide both the audio and a name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声と名前の両方を入力してください。"
          }
        }
      }
    },
    "음성이 너무 짧아요. 다시 녹음해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio is too short. Please record again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が短すぎます。もう一度録音してください。"
          }
        }
      }
    },
    "응원": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheer up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応援"
          }
        }
      }
    },
    "이 iOS 버전에서는 알람 기능을 사용할 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms aren't available on this iOS version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiOSバージョンではアラーム機能を使用できません。"
          }
        }
      }
    },
    "이 계정으로는 접근할 수 없는 기능이 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some features aren't available with this account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでは利用できない機能があります。"
          }
        }
      }
    },
    "이 구성원을 내보낼까요? 다시 초대하려면 새 초대 코드가 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this member? You'll need a new invite code to invite them again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメンバーを退出させますか？もう一度招待するには新しい招待コードが必要です。"
          }
        }
      }
    },
    "이 기능은 가족 플랜에서 사용할 수 있어요. 가족 구성원과 알람과 메시지를 함께 나눠보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is available on the Family plan. Share alarms and messages with family members."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はファミリープランで利用できます。家族とアラームやメッセージを共有しましょう。"
          }
        }
      }
    },
    "이 기능은 개인 플랜에서 사용할 수 있어요. 업그레이드해서 녹음과 공유 목소리 기능을 사용해 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is available on the Personal plan. Upgrade to use recording and shared voice features."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能は個人プランで利用できます。アップグレードして録音と共有音声機能を使ってみましょう。"
          }
        }
      }
    },
    "이 기능은 개인 플랜에서 사용할 수 있어요. 업그레이드해서 더 많은 목소리 슬롯을 열어보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is available on the Personal plan. Upgrade to unlock more voice slots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はパーソナルプランでご利用いただけます。アップグレードして、もっと多くの声スロットを解放しましょう。"
          }
        }
      }
    },
    "이 기능은 무료 플랜에서도 사용할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is available on the free plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能は無料プランでも利用できます。"
          }
        }
      }
    },
    "이 기능은 커플 플랜에서 사용할 수 있어요. 두 사람의 알람을 함께 관리해 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is available on the Couple plan. Manage alarms together for two people."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はカップルプランで利用できます。2人のアラームを一緒に管理しましょう。"
          }
        }
      }
    },
    "이 목소리 사용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this voice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声を使う"
          }
        }
      }
    },
    "이 목소리 선택": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this voice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声を選択"
          }
        }
      }
    },
    "이 목소리가 나를 뭐라고 부를까요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should this voice call me?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声に何と呼ばれたいですか？"
          }
        }
      }
    },
    "이 목소리가 나를 부를 이름": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this voice will call me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声が私を呼ぶ名前"
          }
        }
      }
    },
    "이 목소리가 나를 부를 이름을 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter the name this voice will call you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声があなたを呼ぶ名前を入力してください。"
          }
        }
      }
    },
    "이 목소리가 나를 부를 호칭": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this voice will call you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声があなたを呼ぶ呼び名"
          }
        }
      }
    },
    "이 목소리가 나를 부를 호칭을 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter what this voice will call you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声があなたを呼ぶ呼び名を入力してください。"
          }
        }
      }
    },
    "이 목소리가 나를 어떻게 부를지 설정": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set how this voice calls you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声があなたをどう呼ぶか設定"
          }
        }
      }
    },
    "이 목소리가 부를 호칭": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this voice will call you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声が呼ぶ呼び名"
          }
        }
      }
    },
    "이 목소리는 이렇게 불러줘요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how the voice will call you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声はこう呼んでくれます"
          }
        }
      }
    },
    "이 목소리로 만든 알람은 기본 알람음으로 바뀌고, 저장된 음성도 함께 지워져요. 되돌릴 수 없어요. 이번 달에는 새 목소리를 만들 수 없고, 다음 달부터 다시 만들 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms using this voice go back to the default alarm sound, and the saved audio is deleted too. This cannot be undone. You will not be able to create a new voice until next month."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声で作ったアラームは基本のアラーム音に戻り、保存された音声も一緒に削除されます。元に戻せません。今月は新しい声を作れず、来月から作成できます。"
          }
        }
      }
    },
    "이 목소리로 시작하기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with this voice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声ではじめる"
          }
        }
      }
    },
    "이 목소리로 저장할까요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this voice?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声で保存しますか?"
          }
        }
      }
    },
    "이 목소리를 쓰는 메시지는 텍스트만 남고, 알람은 기본 알람음으로 바뀌어요. 저장된 음원 파일도 함께 삭제돼요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages using this voice will keep only their text, and alarms switch to the default sound. Saved audio files are deleted too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声を使うメッセージはテキストだけが残り、アラームは標準の音に変わります。保存された音源ファイルも一緒に削除されます。"
          }
        }
      }
    },
    "이 문구로 다시 듣기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen again with this phrase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文言でもう一度聞く"
          }
        }
      }
    },
    "이 문구를 그대로 읽어 드려요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll read this phrase exactly as written."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文言をそのまま読み上げます。"
          }
        }
      }
    },
    "이 시간대 삭제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this time slot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間帯を削除"
          }
        }
      }
    },
    "이 알람에 저장된 목소리는 그대로 울리지만, 문구를 바꾸려면 다른 목소리를 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice saved to this alarm will still play, but to change the phrase, please choose another voice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアラームに保存された声はそのまま鳴りますが、文を変えるには別の声を選択してください。"
          }
        }
      }
    },
    "이 코드를 등록할까요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register this code?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを登録しますか？"
          }
        }
      }
    },
    "이름": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        }
      }
    },
    "이름 수정": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を編集"
          }
        }
      }
    },
    "이름 없음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前なし"
          }
        }
      }
    },
    "이름·관계와 '나를 부를 호칭'을 입력하면, 랜덤 문구에서 그 호칭으로 다정하게 불러줘요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the name, relationship, and what it should call you, and random messages will warmly call you by that name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前・関係と「あなたの呼び名」を入力すると、ランダムな文言でその呼び名で優しく呼んでくれます。"
          }
        }
      }
    },
    "이름은 %lld자까지 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names can be up to %lld characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は%lld文字まで使えます。"
          }
        }
      }
    },
    "이름은 50자 이내로 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please keep the name within 50 characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は50文字以内で入力してください。"
          }
        }
      }
    },
    "이름을 비울 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name can't be empty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を空にはできません。"
          }
        }
      }
    },
    "이메일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレス"
          }
        }
      }
    },
    "이메일 또는 비밀번호가 맞지 않아요. 다시 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email or password doesn't match. Please check and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはパスワードが正しくありません。ご確認ください。"
          }
