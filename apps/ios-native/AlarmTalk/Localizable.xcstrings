    "남성": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Male"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "男性"
          }
        }
      }
    },
    "남은 기간 요금은 비례 환불되고 이용권이 바로 종료돼요. 목소리는 3일간 보관돼요 — 그 안에 다시 이용권을 등록하면 그대로 다시 쓸 수 있고, 지나면 영구 삭제돼요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remaining period is refunded pro rata and your plan ends right away. Your voice is kept for 3 days — resubscribe within that window and it comes back as it was; after that it is deleted for good."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り期間の料金は日割りで返金され、プランはすぐに終了します。声は3日間保管されます — その間に再登録すればそのまま使え、過ぎると完全に削除されます。"
          }
        }
      }
    },
    "남자친구": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyfriend"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼氏"
          }
        }
      }
    },
    "남편": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Husband"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夫"
          }
        }
      }
    },
    "내 계정에서만 사용해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only on my account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のアカウントでのみ使用します。"
          }
        }
      }
    },
    "내 목소리": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My voice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声"
          }
        }
      }
    },
    "내 목소리 · 공유 중": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My voice · Sharing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声 · 共有中"
          }
        }
      }
    },
    "내 목소리 만들기, 광고 제거, 개인 이용권 선물": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your own voice, remove ads, and gift a Personal pass"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声の作成、広告非表示、個人パスのギフト"
          }
        }
      }
    },
    "내 목소리 만들기는 유료 기능이에요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating your own voice is a paid feature"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声を作るのは有料機能です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 목소리 만들기는 유료 기능이에요"
          }
        }
      }
    },
    "내 목소리가 알람으로 들린다면 어떤 말이 가장 힘이 될지 생각하며 편하게 말해볼게.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking about which words would be most encouraging to hear as an alarm, I'll just speak naturally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の声がアラームで聞こえるなら、どんな言葉が一番力になるか考えながら、気楽に話してみるね。"
          }
        }
      }
    },
    "내 목소리를 녹음해 클로닝하거나 미리듣기를 하려면 마이크 권한이 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone permission is needed to record and clone your voice or play previews."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声を録音してクローンを作ったり、プレビューを再生するにはマイクの権限が必要です。"
          }
        }
      }
    },
    "내 목소리를 만들어 두면, 그 목소리로 알람이 깨워줘요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your own voice, and it'll wake you up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声を作っておくと、その声でアラームが起こしてくれます。"
          }
        }
      }
    },
    "내 목소리를 만들어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your own voice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声を作りましょう"
          }
        }
      }
    },
    "내 목소리를 알람에 쓰고 싶을 때만 필요해요.\n녹음하거나 업로드한 목소리를 음성 프로필 생성·클론·TTS 생성에 사용하며, 개인을 식별·재현할 수 있는 생체정보로 처리합니다.\n지금 동의하지 않아도 기본 목소리 알람은 그대로 쓸 수 있고, 나중에 목소리를 등록할 때 다시 여쭤봐요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only needed if you want to use your own voice for alarms.\nRecorded or uploaded voices are used to create voice profiles, clone voices, and generate TTS, and are processed as biometric information that can identify or reproduce a person.\nDeclining keeps the built-in voices working, and we will ask again when you register a voice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声をアラームに使いたい場合にのみ必要です。\n録音またはアップロードした声を音声プロフィール作成・音声クローン・TTS生成に使用し、個人を識別または再現し得る生体情報として処理します。\n同意しなくても標準の声のアラームはそのまま使え、声を登録するときに改めてお伺いします。"
          }
        }
      }
    },
