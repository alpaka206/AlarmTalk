    },
    "회원 탈퇴 신청에 실패했어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't submit your account deletion request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退会の申請に失敗しました。"
          }
