    },
    "회원 탈퇴가 완료됐어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has been deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退会が完了しました。"
          }
        }
      }
    },
    "회원 탈퇴가 접수됐어요. 30일 안에 다시 로그인하면 취소할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account deletion request has been received. You can cancel it by logging back in within 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退会の申請を受け付けました。30日以内に再度ログインすると取り消せます。"
          }
        }
      }
    },
    "회원 탈퇴가 진행 중이에요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account deletion is in progress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退会手続きが進行中です"
          }
        }
      }
    },
    "회원 탈퇴를 취소했어요. 계정이 복구됐어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account deletion was canceled. Your account has been restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退会をキャンセルしました。アカウントが復元されました。"
          }
