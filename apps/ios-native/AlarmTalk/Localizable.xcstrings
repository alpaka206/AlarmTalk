    },
    "%@ 이용권은 %@이에요. App Store로 안전하게 결제되고 언제든 해지할 수 있어요. 해지해도 남은 기간은 그대로 이용할 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ plan costs %2$@. Payment is handled securely by the App Store. You can cancel anytime and keep access for the rest of your paid period."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@プランは%2$@です。App Storeで安全に決済でき、いつでも解約できます。解約後も残りの期間は引き続き利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이용권은 %@이에요. App Store로 안전하게 결제되고 언제든 해지할 수 있어요. 해지해도 남은 기간은 그대로 이용할 수 있어요."
          }
        }
      }
    },
    "%@ 이용권을 App Store로 안전하게 결제해요. 가격은 결제 화면에서 확인할 수 있고, 언제든 해지할 수 있어요. 해지해도 남은 기간은 그대로 이용할 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase the %@ plan securely through the App Store. Check the price on the payment screen. You can cancel anytime and keep access for the rest of your paid period."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@プランはApp Storeで安全に決済できます。価格は決済画面で確認でき、いつでも解約できます。解約後も残りの期間は引き続き利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이용권을 App Store로 안전하게 결제해요. 가격은 결제 화면에서 확인할 수 있고, 언제든 해지할 수 있어요. 해지해도 남은 기간은 그대로 이용할 수 있어요."
          }
        }
      }
    },
    "%@ 이용권을 시작할까요?" : {
