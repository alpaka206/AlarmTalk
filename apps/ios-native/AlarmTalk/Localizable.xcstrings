    },
    "알람을 예약했어요. %lld초 목소리는 iOS 제한으로 기본 알람음 뒤 앱이 열려 있을 때 재생돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm scheduled. Due to iOS limits, the %lld-second voice plays after the default alarm sound while the app is open."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラームを予約しました。iOSの制限により、%lld秒の音声は標準のアラーム音の後、アプリが開いているときに再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알람을 예약했어요. %lld초 목소리는 iOS 제한으로 기본 알람음 뒤 앱이 열려 있을 때 재생돼요."
          }
        }
      }
    },
    "%@ 알람을 예약했어요. %lld초 목소리는 iOS 제한으로 기본 알람음 뒤 앱이 열려 있을 때 재생돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheduled the %1$@ alarm. Due to iOS limits, the %2$lld-second voice plays after the default alarm sound while the app is open."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のアラームを予約しました。iOSの制限により、%2$lld秒の音声は標準のアラーム音の後、アプリが開いているときに再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 알람을 예약했어요. %lld초 목소리는 iOS 제한으로 기본 알람음 뒤 앱이 열려 있을 때 재생돼요."
          }
        }
