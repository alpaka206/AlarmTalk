      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remaining period is refunded pro rata and your plan ends right away. Your voice is kept for 3 days. Resubscribe within that window and it comes back as it was; after that it is deleted for good."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残り期間の料金は日割りで返金され、利用券はすぐに終了します。声は3日間保管され、その間に利用券を購読し直せばそのまま使えます。過ぎると完全に削除されます。"
          }
