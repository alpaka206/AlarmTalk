        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告の準備時間が過ぎました。もう一度お試しください。"
          }
        }
      }
    },
    "지금은 광고를 볼 수 없어요. 만들어 둔 음성과 기본 문구는 그대로 쓸 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ads aren't available right now. Voices you made and the basic messages still work."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は広告を表示できません。作成済みの音声と基本の文言はそのまま使えます。"
          }
        }
      }
    },
    "광고 보고 한 번 쓰기" : {
      "extractionState" : "manual",
