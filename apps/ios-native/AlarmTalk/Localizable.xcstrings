        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 업데이트해야 동의를 진행할 수 있어요."
          }
        }
      }
    },
    "약관이 개정되어 다시 동의가 필요해요" : {
