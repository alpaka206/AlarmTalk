            "value": "占い情報"
          }
        }
      }
    },
    "운세가 들어간 깨움말을 만들 때만 사용해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when creating fortune-based wake-up messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "占いを含む起こし文を作るときだけ使います。"
          }
        }
      }
    },
    "운세가 들어간 랜덤 깨움말을 만들 때만 사용해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when creating fortune-based random wake-up phrases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "占いを含むランダムなお目覚めメッセージを作るときだけ使います。"
          }
        }
      }
    },
    "운세가 들어간 문구를 쓰려면 성별, 생년월일, 태어난 시간이 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use fortune-based messages, gender, date of birth, and time of birth are required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "占いを使った文を作るには、性別・生年月日・生まれた時間が必要です。"
          }
        }
      }
    },
    "운세에 쓸 정보를 모두 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please fill in all the info for the fortune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運勢に使う情報をすべて入力してください。"
          }
        }
      }
    },
    "원본 음원을 찾지 못했어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find the original audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の音源が見つかりませんでした。"
          }
        }
      }
    },
    "원하는 목소리 1개 등록": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register 1 voice of your choice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きな声を1つ登録"
          }
        }
      }
    },
    "원활하고 안전한 이용을 위해\n최신 버전으로 업데이트해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please update to the latest version\nfor a smooth and secure experience."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "快適で安全にご利用いただくため\n最新バージョンにアップデートしてください。"
          }
        }
      }
    },
    "원활한 서비스 제공을 위해 아래 약관에 대한 동의가 필요해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your agreement to the terms below to provide a smooth service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スムーズなサービス提供のため、以下の規約への同意が必要です。"
          }
        }
      }
    },
